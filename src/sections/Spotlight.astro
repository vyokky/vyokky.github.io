---
import { ArrowUpRight, FileText, Globe, Layers } from "lucide-react";
import BrandIcon from "../components/BrandIcon.astro";
import ExperienceLoop from "../islands/ExperienceLoop";
import ModelBench from "../islands/ModelBench";

// Public sources only: CV, arXiv 2611.02102, beipo.top/blog/northcua, Hugging Face beipo-ai, GitHub beipo-ai/NorthCUA.
const LINKS = [
  { label: "Technical report", href: "https://arxiv.org/abs/2611.02102", icon: "report", primary: true },
  { label: "Project page", href: "https://beipo.top/blog/northcua/en/", icon: "globe" },
  { label: "Models", href: "https://huggingface.co/beipo-ai", icon: "layers" },
  { label: "Code", href: "https://github.com/beipo-ai/NorthCUA", icon: "github" },
];

// Spec band: three facts, each with its qualification spelled out.
const FACTS = [
  {
    big: "Open-source SOTA",
    small: "among open-source models under the reported settings, in GUI grounding, desktop execution and web interaction",
  },
  { big: "9B to 397B", small: "three open models: Nano (dense), Mini (3B active) and Pro (17B active), built on Qwen3.5" },
  {
    big: "2.3×",
    small:
      "lower mean task time with NorthCUA-Ultrafast (pre-RL Nano, 320 fixed successful WebArena-Verified tasks, 60.6% vs 64.2% success)",
  },
];
---

<section id="northcua" data-reveal class="mb-24">
  <h2 class="mb-6 border-b-2 border-accent pb-2 text-2xl font-bold tracking-tight text-gray-800">Spotlight: NorthCUA</h2>

  <div class="beam-border shadow-lift">
    <div class="relative overflow-clip rounded-[15px] bg-white">
      <div aria-hidden="true" class="dot-grid absolute inset-0"></div>
      <div aria-hidden="true" class="absolute -top-28 -right-28 h-80 w-80 rounded-full bg-accent-soft/20 blur-3xl"></div>

      <div class="relative p-6 sm:p-8 md:p-12">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-gray-500">
          <span class="inline-flex items-center gap-2 rounded-full border border-accent/40 bg-accent/10 px-2.5 py-0.5 text-xs font-medium text-accent-ink">
            <span class="pulse-dot inline-block h-1.5 w-1.5 rounded-full bg-accent"></span>
            Open source, Nov 2026
          </span>
          <span>Project lead · co-first author · core contributor</span>
        </div>

        <h3 class="mt-5 text-5xl leading-[0.95] font-bold tracking-[-0.035em] text-gray-800 md:text-6xl">
          North<span class="text-accent">CUA</span>
        </h3>
        <p class="mt-3 text-lg tracking-tight text-gray-600 md:text-xl">Turbocharging Computer-Use Agents through Experience at Scale</p>
        <p class="mt-6 max-w-[68ch] leading-relaxed text-gray-600">
          NorthCUA is an experience-driven computer-use agent system that turns natural-language goals into work across
          desktop applications and the web. I lead it from zero to one at <strong class="text-gray-800">Beipo</strong>: a
          <strong class="text-gray-800">unified harness</strong> that executes, verifies and preserves long-horizon tasks, an
          <strong class="text-gray-800">experience flywheel</strong> that turns weak spots into high-value training data, and
          <strong class="text-gray-800">staged post-training</strong> that turns that experience into stronger policies.
        </p>

        <div class="mt-7 flex flex-wrap gap-3">
          {
            LINKS.map((l) => (
              <a
                href={l.href}
                target="_blank"
                rel="noopener noreferrer"
                class:list={[
                  "group inline-flex items-center gap-2 rounded-lg px-4 py-2.5 text-sm font-medium whitespace-nowrap transition",
                  l.primary
                    ? "bg-accent-ink text-white shadow-card hover:bg-accent-deep"
                    : "border border-accent/50 bg-white/80 text-accent-ink hover:border-accent hover:bg-accent/10",
                ]}
              >
                {l.icon === "report" && <FileText size={16} />}
                {l.icon === "globe" && <Globe size={16} />}
                {l.icon === "layers" && <Layers size={16} />}
                {l.icon === "github" && <BrandIcon name="github" size={15} />}
                {l.label}
                <ArrowUpRight size={14} className="opacity-70 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
              </a>
            ))
          }
        </div>

        <dl class="mt-10 grid border-y border-hairline md:grid-cols-3 md:divide-x md:divide-hairline">
          {
            FACTS.map((f, i) => (
              <div class:list={["py-5 md:px-6", i === 0 && "md:pl-0", i > 0 && "border-t border-hairline md:border-t-0"]}>
                <dt class="text-2xl font-semibold tracking-tight text-gray-800 md:text-[1.75rem]">{f.big}</dt>
                <dd class="mt-1.5 text-sm leading-relaxed text-gray-500">{f.small}</dd>
              </div>
            ))
          }
        </dl>

        <div class="mt-14">
          <h4 class="text-2xl font-semibold tracking-tight text-gray-800">How it learns</h4>
          <p class="mt-1 mb-8 text-gray-500">One loop, from executing real tasks to training on what they taught. Scroll through it.</p>
          <ExperienceLoop client:visible />
        </div>

        <div class="glow-card mt-14 rounded-xl border border-hairline bg-white/80 p-5 md:p-7">
          <h4 class="text-2xl font-semibold tracking-tight text-gray-800">Model family</h4>
          <p class="mt-1 mb-6 text-sm text-gray-500">Switch sizes to compare scores on the same three benchmarks.</p>
          <ModelBench client:visible />
        </div>
      </div>
    </div>
  </div>
</section>
