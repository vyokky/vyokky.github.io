---
import FlowField from "../islands/FlowField";
import { GITHUB, LINKEDIN, SCHOLAR } from "../data/links";
import type { Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const zh = lang === "zh";
const link = "text-gray-600 transition-colors hover:text-accent-ink";
---

<footer class="relative overflow-hidden">
  <!-- closing beat: faint streamlines, echoing the network field in the hero -->
  <FlowField client:visible className="absolute inset-0 h-full w-full [mask-image:linear-gradient(to_bottom,transparent,#000_35%,#000_75%,transparent)]" />
  <div aria-hidden="true" class="absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-accent/60 to-transparent"></div>
  <div class="relative container mx-auto max-w-6xl px-5 pt-20 pb-10 md:px-8 md:pt-28">
    <p class="max-w-3xl text-[1.75rem] leading-tight font-semibold tracking-[-0.03em] text-gray-900 md:text-[2.5rem]">
      {zh ? "让智能体在真实软件里，从经验中持续变强。" : "Agents that get better at real software, one experience at a time."}
    </p>
    <div class="mt-14 flex flex-col gap-4 border-t border-hairline pt-6 sm:flex-row sm:items-center sm:justify-between">
      <div class="text-sm text-gray-500">
        <span class="font-medium text-gray-700">{zh ? "张朝运" : "Chaoyun Zhang"}</span> · © 2026 · {zh ? "更新于 2026 年 11 月" : "Last updated November 2026"}
      </div>
      <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
        <a href={GITHUB} target="_blank" rel="noopener noreferrer" class={link}>GitHub</a>
        <a href={SCHOLAR} target="_blank" rel="noopener noreferrer" class={link}>{zh ? "谷歌学术" : "Google Scholar"}</a>
        <a href={LINKEDIN} target="_blank" rel="noopener noreferrer" class={link}>LinkedIn</a>
      </div>
    </div>
  </div>
</footer>
