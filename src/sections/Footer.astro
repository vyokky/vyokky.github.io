---
import { EMAIL, GITHUB, LINKEDIN, SCHOLAR } from "../data/links";
const link = "text-gray-600 transition-colors hover:text-accent-ink";
---

<footer class="border-t border-hairline">
  <div class="container mx-auto max-w-6xl px-4 py-12">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-sm text-gray-500">Get in touch</p>
        <a href={`mailto:${EMAIL}`} class="mt-1 inline-block text-2xl font-semibold tracking-tight text-gray-800 transition-colors hover:text-accent-ink md:text-3xl">{EMAIL}</a>
      </div>
      <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm">
        <a href={GITHUB} target="_blank" rel="noopener noreferrer" class={link}>GitHub</a>
        <a href={SCHOLAR} target="_blank" rel="noopener noreferrer" class={link}>Google Scholar</a>
        <a href={LINKEDIN} target="_blank" rel="noopener noreferrer" class={link}>LinkedIn</a>
      </div>
    </div>
    <div class="mt-10 flex flex-col items-start justify-between gap-2 text-xs text-gray-500 sm:flex-row sm:items-center">
      <span>© 2026 Chaoyun Zhang</span>
      <span>Last updated November 2026</span>
    </div>
  </div>
</footer>
