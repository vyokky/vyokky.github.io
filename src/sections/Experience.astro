---
import A from "../components/A.astro";
import Section from "../components/Section.astro";

const node =
  "absolute top-7 -left-9 flex h-[23px] w-[23px] items-center justify-center rounded-full border border-accent/50 bg-white shadow-card md:-left-11 md:h-[31px] md:w-[31px]";
const smallNode =
  "absolute top-1.5 -left-9 flex h-[23px] w-[23px] items-center justify-center rounded-full border border-hairline bg-white md:-left-11 md:h-[31px] md:w-[31px]";

const EDUCATION = [
  {
    t: "Ph.D. in Informatics",
    org: "University of Edinburgh",
    p: "2016 – 2020",
    d: "Deep neural mobile networking.",
    sup: true,
  },
  {
    t: "MSc in Artificial Intelligence",
    org: "University of Edinburgh",
    p: "2015 – 2016",
    d: "Distinction (79/100). Non-intrusive load monitoring.",
  },
  {
    t: "BEng in Telecommunication Engineering",
    org: "Huazhong University of Science and Technology",
    p: "2011 – 2015",
    d: "Leaf recognition with CNNs and data augmentation.",
  },
];
---

<Section id="experience" title="Experience">
  <div class="timeline relative pl-9 md:pl-11">
    <div aria-hidden="true" class="absolute top-3 bottom-3 left-[11px] w-px bg-hairline md:left-[15px]"></div>
    <div aria-hidden="true" class="timeline-fill absolute top-3 bottom-3 left-[11px] w-px bg-linear-to-b from-accent to-accent-soft md:left-[15px]"></div>

    <ol class="space-y-5">
      <!-- Beipo -->
      <li class="relative" data-reveal>
        <span aria-hidden="true" class={node}><span class="pulse-dot node-glow h-2 w-2 rounded-full bg-accent-ink"></span></span>
        <article class="glow-card surface surface-hover card">
          <header class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
            <h3 class="t-h3">Head of Computer-Using Agents</h3>
            <p class="t-meta flex items-center gap-2">Feb 2026 – now <span class="chip">Current</span></p>
          </header>
          <p class="t-small mt-1 font-medium text-accent-ink">Beipo (北坡) · NorthCUA / Nex-N2.5</p>
          <ul class="mt-4 ml-4 list-outside list-disc space-y-1.5 text-[15px] leading-relaxed text-gray-600 marker:text-accent">
            <li>
              Lead <strong class="font-semibold text-gray-800">NorthCUA</strong> from zero to one: the CUA post-training and model roadmap, combining
              GUI mid-training, long-horizon SFT and joint desktop and web reinforcement learning.
            </li>
            <li>
              Built the unified harness and experience-data flywheel that connect desktop and web execution, trajectory collection, outcome
              verification and training-data curation.
            </li>
            <li>Released the open NorthCUA Nano, Mini and Pro models, and NorthCUA-Ultrafast for low-latency execution.</li>
            <li>Responsible for the CUA and Web Agent capabilities of <A href="https://nex-agi.com" bold={false}>Nex-N2.5</A>.</li>
          </ul>
        </article>
      </li>

      <!-- Microsoft -->
      <li class="relative" data-reveal>
        <span aria-hidden="true" class={node}><span class="node-glow h-2 w-2 rounded-full bg-accent"></span></span>
        <article class="glow-card surface surface-hover card">
          <header class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
            <h3 class="t-h3">Principal Researcher</h3>
            <p class="t-meta">Jul 2022 – Feb 2026</p>
          </header>
          <p class="t-small mt-1 font-medium text-accent-ink">Microsoft AI / Microsoft Research Asia · DKI · Shanghai</p>
          <ul class="mt-4 ml-4 list-outside list-disc space-y-1.5 text-[15px] leading-relaxed text-gray-600 marker:text-accent">
            <li>
              Lead developer and algorithm researcher of <strong class="font-semibold text-gray-800">UFO, UFO² and UFO³</strong>, the first open-source
              Windows GUI agent / CUA framework, which grew into a cross-platform, cross-device Desktop AgentOS (10K+ GitHub stars).
            </li>
            <li>Trained and evaluated desktop GUI agents and action models; led the LLM-brained GUI agent survey.</li>
            <li>AIOps: anomaly detection, failure diagnosis and root cause analysis deployed in cloud operations.</li>
          </ul>
        </article>
      </li>

      <!-- Tencent -->
      <li class="relative" data-reveal>
        <span aria-hidden="true" class={node}><span class="node-glow h-2 w-2 rounded-full bg-accent"></span></span>
        <article class="glow-card surface surface-hover card">
          <header class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
            <h3 class="t-h3">Applied Research Scientist</h3>
            <p class="t-meta">Dec 2020 – Jul 2022</p>
          </header>
          <p class="t-small mt-1 font-medium text-accent-ink">Lightspeed and Quantum Studio (光子工作室群), Tencent · Shenzhen</p>
          <p class="mt-4 text-[15px] leading-relaxed text-gray-600">
            Matchmaking for <i>League of Legends: Wild Rift</i>: novice skill estimation and multi-objective re-matchmaking, both deployed at
            million-DAU scale (QuickSkill, CIKM 2022; CUPID, CSCW 2024; two patents).
          </p>
        </article>
      </li>

      <!-- Education: lighter rows on the same line -->
      <li class="relative pt-6" data-reveal>
        <p class="t-label mb-4 text-gray-500">Education</p>
        <ol class="divide-y divide-hairline border-y border-hairline">
          {
            EDUCATION.map((e) => (
              <li class="relative grid gap-x-6 gap-y-0.5 py-4 sm:grid-cols-[minmax(0,1fr)_auto]">
                <span aria-hidden="true" class={smallNode}>
                  <span class="h-1.5 w-1.5 rounded-full bg-accent/70" />
                </span>
                <div class="min-w-0">
                  <p class="font-semibold tracking-[-0.01em] text-gray-900">
                    {e.t} <span class="font-normal text-gray-500">· {e.org}</span>
                  </p>
                  <p class="t-small text-gray-600">
                    {e.d}
                    {e.sup && (
                      <>
                        {" "}Supervised by <A href="https://homepages.inf.ed.ac.uk/ppatras/" bold={false}>Paul Patras</A> and{" "}
                        <A href="https://homepages.inf.ed.ac.uk/rsarkar/" bold={false}>Rik Sarkar</A>.
                      </>
                    )}
                  </p>
                </div>
                <p class="t-meta sm:pt-1">{e.p}</p>
              </li>
            ))
          }
        </ol>
      </li>
    </ol>
  </div>
</Section>
