---
import { Award, BookOpenCheck, FileText, ScrollText, Users } from "lucide-react";
import Section from "../components/Section.astro";

const GROUPS = [
  {
    title: "Program committee",
    icon: "users",
    items: [
      ["ICSE 2027", "International Conference on Software Engineering"],
      ["FSE 2025 Industry Track", "Foundations of Software Engineering"],
      ["ACM DistributedML 2020", "Distributed Machine Learning Workshop"],
      ["IEEE CCNC 2020", "Consumer Communications & Networking"],
    ],
  },
  {
    title: "Reviewing",
    icon: "review",
    items: [
      ["NeurIPS 2025", "Neural Information Processing Systems"],
      ["ICLR 2025", "Learning Representations"],
      ["KDD ADS 2025", "Applied Data Science Track"],
      ["ACL ARR", "Association for Computational Linguistics"],
      ["IEEE TMA · WCNC · WoWMoM", "Networking and measurement venues"],
    ],
  },
  {
    title: "Journals",
    icon: "journal",
    items: [
      ["ACM Computing Surveys", "CSUR"],
      ["IEEE Trans. Mobile Computing", "TMC"],
      ["IEEE Trans. Smart Grid", "TSG"],
      ["IEEE Communications Letters", "ComLet"],
      ["IEEE SECOM", "Systems Engineering"],
    ],
  },
];
const AWARDS = [
  ["2018", "Best Student Paper Award, MLN"],
  ["2018", "ACM MobiHoc Student Travel Grant"],
  ["2017", "Outstanding MSc Dissertation Award, University of Edinburgh"],
  ["2016", "Edinburgh Global Research Scholarship"],
];
const PATENTS = [
  ["US12244467B2", "Distributed network traffic data decomposition method (granted)"],
  ["US 18/428,627", "Customized anomaly monitor for compute system performance metrics"],
  ["CN116785718A", "Novice skill detection for MOBA games"],
  ["CN116850601A", "Multi-objective optimization for MOBA matchmaking and position assignment"],
];
const head = "mb-4 flex items-center gap-2.5";
const iconBox = "grid h-8 w-8 place-items-center rounded-lg bg-accent/10 text-accent-ink";
---

<Section id="service" title="Service & Honors">
  <div class="grid gap-6 md:grid-cols-3">
    {
      GROUPS.map((g) => (
        <div class="glow-card surface surface-hover card">
          <div class={head}>
            <span class={iconBox}>
              {g.icon === "users" && <Users size={16} />}
              {g.icon === "review" && <BookOpenCheck size={16} />}
              {g.icon === "journal" && <FileText size={16} />}
            </span>
            <h3 class="t-label text-[0.9375rem]">{g.title}</h3>
          </div>
          <ul class="divide-y divide-hairline">
            {g.items.map(([t, s]) => (
              <li class="py-2.5">
                <p class="text-[15px] font-medium tracking-[-0.01em] text-gray-900">{t}</p>
                <p class="t-small text-gray-500">{s}</p>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <div class="mt-6 grid gap-6 md:grid-cols-2">
    <div class="glow-card surface surface-hover card">
      <div class={head}>
        <span class={iconBox}><Award size={16} /></span>
        <h3 class="t-label text-[0.9375rem]">Awards</h3>
      </div>
      <ul class="divide-y divide-hairline">
        {
          AWARDS.map(([y, t]) => (
            <li class="grid grid-cols-[3.5rem_minmax(0,1fr)] items-baseline gap-3 py-2.5">
              <span class="t-meta">{y}</span>
              <span class="text-[15px] text-gray-800">{t}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="glow-card surface surface-hover card">
      <div class={head}>
        <span class={iconBox}><ScrollText size={16} /></span>
        <h3 class="t-label text-[0.9375rem]">Patents</h3>
      </div>
      <ul class="divide-y divide-hairline">
        {
          PATENTS.map(([id, t]) => (
            <li class="grid items-baseline gap-x-3 gap-y-0.5 py-2.5 sm:grid-cols-[8.5rem_minmax(0,1fr)]">
              <span class="t-meta text-accent-ink">{id}</span>
              <span class="text-[15px] text-gray-800">{t}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Section>
