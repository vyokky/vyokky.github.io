---
import { Image } from "astro:assets";
import { ArrowRight, ArrowUpRight, Mail } from "lucide-react";
import NetworkField from "../islands/NetworkField";
import BrandIcon from "../components/BrandIcon.astro";
import profile from "../assets/profile.jpg";
import { publications } from "../data/publications";
import { EMAIL, GITHUB, LINKEDIN, SCHOLAR } from "../data/links";
import type { Lang } from "../i18n";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const zh = lang === "zh";

const T = zh
  ? {
      eyebrow: "Chaoyun Zhang",
      name: "张朝运",
      role: ["北坡", " 计算机使用智能体（CUA）负责人"],
      previously: "曾任微软首席研究员（Principal Researcher）",
      lead: "我构建能操作真实桌面软件与网页的智能体，以及让它们在实践中持续变强的经验闭环。",
      cta: "正在负责 NorthCUA",
      scholar: "谷歌学术",
      email: "邮箱",
      stats: ["Google Scholar 引用", "UFO GitHub Stars", "论文", "开源 NorthCUA 模型"],
    }
  : {
      eyebrow: "张朝运",
      name: "Chaoyun Zhang",
      role: ["Head of Computer-Using Agents at ", "Beipo"],
      previously: "Previously Principal Researcher at Microsoft",
      lead: "I build agents that operate real desktop software and the web, and the experience loops that make them better with practice.",
      cta: "Now leading NorthCUA",
      scholar: "Scholar",
      email: "Email",
      stats: ["Citations", "UFO GitHub stars", "Publications", "Open NorthCUA models"],
    };

// Proof band: every number links to where it comes from.
const STATS = [
  { value: "8,100+", label: T.stats[0], href: SCHOLAR },
  { value: "10K+", label: T.stats[1], href: "https://github.com/microsoft/UFO" },
  { value: String(publications.length), label: T.stats[2], href: "#publications" },
  { value: "3", label: T.stats[3], href: "https://huggingface.co/beipo-ai" },
];
---

<header id="top" class="relative overflow-hidden bg-accent-soft/10">
  <NetworkField client:idle className="absolute inset-0 h-full w-full" />
  <!-- veil: keeps the lines faint behind the text, livelier toward the edges -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0"
    style="background: radial-gradient(ellipse 60% 70% at 35% 45%, rgb(251 253 252 / 0.82), rgb(251 253 252 / 0) 72%)"
  >
  </div>

  <div class="relative container mx-auto flex max-w-6xl flex-col px-5 md:min-h-[calc(100dvh-var(--nav-h))] md:px-8">
    <div class="flex flex-1 flex-col-reverse items-center gap-12 pt-14 md:flex-row md:gap-16 md:pt-10">
      <div class="w-full min-w-0 flex-1">
        <p class="intro t-meta mb-5 flex items-center gap-2 text-accent-ink" style="--d: 0ms">
          <span class="h-px w-8 bg-accent"></span> {T.eyebrow}
        </p>
        <h1 class="intro t-display" style="--d: 80ms">{T.name}</h1>
        <p class="intro mt-6 text-xl tracking-[-0.015em] text-gray-700 md:text-[1.375rem]" style="--d: 180ms">
          {zh ? <><span class="font-semibold text-gray-900">{T.role[0]}</span>{T.role[1]}</> : <>{T.role[0]}<span class="font-semibold text-gray-900">{T.role[1]}</span></>}
          <span class="mt-1 block text-[0.85em] text-gray-500">{T.previously}</span>
        </p>
        <p class="intro t-lead mt-4 max-w-[34rem] text-gray-600" style="--d: 260ms">{T.lead}</p>
        <div class="intro mt-9 flex flex-wrap items-center gap-x-6 gap-y-3" style="--d: 360ms">
          <a
            href="#northcua"
            class="btn-primary group inline-flex min-h-[44px] items-center gap-2 rounded-full py-2 pr-3.5 pl-4 text-sm font-medium whitespace-nowrap"
          >
            <span class="pulse-dot inline-block h-1.5 w-1.5 rounded-full bg-accent-soft"></span>
            {T.cta}
            <ArrowRight size={15} className="transition-transform duration-300 group-hover:translate-x-0.5" />
          </a>
          <a href={GITHUB} target="_blank" rel="noopener noreferrer" class="group flex min-h-[44px] items-center gap-2 whitespace-nowrap text-gray-600 transition-colors hover:text-accent-ink">
            <BrandIcon name="github" class="transition-transform duration-300 group-hover:scale-110" />
            <span class="text-sm font-medium">GitHub</span>
          </a>
          <a href={LINKEDIN} target="_blank" rel="noopener noreferrer" class="group flex min-h-[44px] items-center gap-2 whitespace-nowrap text-gray-600 transition-colors hover:text-accent-ink">
            <BrandIcon name="linkedin" size={18} class="transition-transform duration-300 group-hover:scale-110" />
            <span class="text-sm font-medium">LinkedIn</span>
          </a>
          <a href={SCHOLAR} target="_blank" rel="noopener noreferrer" class="group flex min-h-[44px] items-center gap-2 whitespace-nowrap text-gray-600 transition-colors hover:text-accent-ink">
            <BrandIcon name="scholar" class="transition-transform duration-300 group-hover:scale-110" />
            <span class="text-sm font-medium">{T.scholar}</span>
          </a>
          <a href={`mailto:${EMAIL}`} class="group flex min-h-[44px] items-center gap-2 whitespace-nowrap text-gray-600 transition-colors hover:text-accent-ink">
            <Mail size={20} className="transition-transform duration-300 group-hover:scale-110" />
            <span class="text-sm font-medium">{T.email}</span>
          </a>
        </div>
      </div>

      <div class="intro avatar-scene shrink-0 p-6 md:p-10" style="--d: 0ms">
        <div class="avatar-rig h-44 w-44 md:h-60 md:w-60">
          <div aria-hidden="true" class="avatar-halo"></div>
          <!-- flat halo ring, sitting just behind the portrait -->
          <svg aria-hidden="true" viewBox="0 0 240 240" class="absolute -inset-[9%] h-[118%] w-[118%]" style="transform: translateZ(-20px)">
            <circle cx="120" cy="120" r="116" fill="none" stroke="#70c1b3" stroke-opacity="0.28" stroke-width="1"></circle>
          </svg>
          <div class="relative h-full w-full overflow-hidden rounded-full ring-4 ring-white" style="box-shadow: 0 30px 60px -24px rgb(19 78 70 / 0.45), 0 0 0 1px rgb(19 78 70 / 0.06)">
            <Image src={profile} alt={zh ? "张朝运" : "Chaoyun Zhang"} width={240} height={240} loading="eager" fetchpriority="high" class="h-full w-full object-cover" />
            <div aria-hidden="true" class="pointer-events-none absolute inset-0 rounded-full" style="background: linear-gradient(160deg, rgb(255 255 255 / 0.28), rgb(255 255 255 / 0) 42%)"></div>
          </div>
          <!-- orbital plane: tilted in 3D so it passes behind and in front of the portrait -->
          <div aria-hidden="true" class="orbit-plane">
            <div class="orbit-spin">
              <svg viewBox="0 0 200 200" class="absolute inset-0 h-full w-full overflow-visible">
                <circle cx="100" cy="100" r="98" fill="none" stroke="#ffffff" stroke-opacity="0.7" stroke-width="2.2"></circle>
                <circle cx="100" cy="100" r="98" fill="none" stroke="#2a7a6e" stroke-opacity="0.8" stroke-width="1" stroke-dasharray="2 4"></circle>
                <circle cx="100" cy="2" r="9" fill="#70c1b3" fill-opacity="0.3"></circle>
                <circle cx="100" cy="2" r="3.8" fill="#2a7a6e" stroke="#ffffff" stroke-width="1.2"></circle>
                <circle cx="100" cy="198" r="2" fill="#70c1b3"></circle>
              </svg>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="intro glass mt-12 mb-10 grid grid-cols-2 overflow-hidden rounded-2xl md:grid-cols-4" style="--d: 480ms">
      {
        STATS.map((s, i) => (
          <a
            href={s.href}
            target={s.href.startsWith("#") ? undefined : "_blank"}
            rel="noopener noreferrer"
            class:list={[
              "group flex flex-col-reverse gap-1 px-5 py-5 transition-colors hover:bg-white/60 md:px-7 md:py-6",
              i % 2 === 1 && "border-l border-hairline",
              i === 2 && "md:border-l md:border-hairline",
              i > 1 && "border-t border-hairline md:border-t-0",
            ]}
          >
            <span class="t-meta flex items-center gap-1 transition-colors group-hover:text-accent-ink">
              {s.label}
              <ArrowUpRight size={12} className="opacity-0 transition-opacity group-hover:opacity-100" />
            </span>
            <span class="text-[1.75rem] leading-tight font-semibold tracking-[-0.035em] text-gray-900 tabular-nums md:text-[2.25rem]">{s.value}</span>
          </a>
        ))
      }
    </div>
  </div>
</header>
