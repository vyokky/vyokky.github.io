---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found | Chaoyun Zhang" description="This page does not exist." noindex>
  <main class="grid min-h-dvh place-items-center px-6">
    <div class="max-w-md">
      <div class="mb-5 h-0.5 w-14 bg-accent"></div>
      <p class="text-sm tracking-wide text-accent-ink">404</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-gray-800">This page does not exist.</h1>
      <p class="mt-3 leading-relaxed text-gray-600">
        The link may be old or mistyped. The homepage has everything: NorthCUA, UFO, publications and contact.
      </p>
      <a href="/" class="mt-6 inline-flex rounded-lg bg-accent-ink px-4 py-2.5 text-sm font-medium text-white shadow-card transition hover:bg-accent-deep">
        Back to the homepage
      </a>
    </div>
  </main>
</Base>
