---
// Small line-drawn animations for the NorthCUA loop steps (after ThreeUI "Diagnostics Panel ·
// Layered Planes" and "Wireframe Forms · Sphere"). Pure SVG + CSS; static under reduced motion.
interface Props {
  kind: "layers" | "ring" | "bars" | "sphere";
}
const { kind } = Astro.props;
---

<svg viewBox="0 0 32 32" width="32" height="32" aria-hidden="true" class:list={["licon", `licon--${kind}`]} fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round">
  {
    kind === "layers" && (
      <>
        <path class="li-layer li-l3" d="M16 19.5 6 15l10-4.5L26 15z" opacity=".35" />
        <path class="li-layer li-l2" d="M16 16.5 6 12l10-4.5L26 12z" opacity=".6" />
        <path class="li-layer li-l1" d="M16 13.5 6 9l10-4.5L26 9z" />
      </>
    )
  }
  {
    kind === "ring" && (
      <>
        <circle cx="16" cy="16" r="10" opacity=".35" />
        <g class="li-spin">
          <circle cx="16" cy="16" r="10" stroke-dasharray="4 3.4" />
          <circle cx="16" cy="6" r="2" fill="currentColor" stroke="none" />
          <circle cx="24.7" cy="21" r="1.4" fill="currentColor" stroke="none" opacity=".7" />
          <circle cx="7.3" cy="21" r="1.4" fill="currentColor" stroke="none" opacity=".7" />
        </g>
      </>
    )
  }
  {
    kind === "bars" && (
      <>
        <path d="M5 26.5h22" opacity=".35" />
        <rect class="li-bar li-b1" x="7" y="16" width="4" height="10" rx="1" />
        <rect class="li-bar li-b2" x="14" y="11" width="4" height="15" rx="1" />
        <rect class="li-bar li-b3" x="21" y="6" width="4" height="20" rx="1" fill="currentColor" fill-opacity=".18" />
      </>
    )
  }
  {
    kind === "sphere" && (
      <>
        <circle cx="16" cy="16" r="10" />
        <ellipse cx="16" cy="16" rx="10" ry="3.6" opacity=".55" />
        <ellipse class="li-meridian li-m1" cx="16" cy="16" rx="10" ry="10" opacity=".55" />
        <ellipse class="li-meridian li-m2" cx="16" cy="16" rx="10" ry="10" opacity=".35" />
      </>
    )
  }
</svg>
